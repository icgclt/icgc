# Copy this file to .env (local) or add the same names in Vercel > Settings > Environment Variables.
# Supabase dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The public "anon" key only. NEVER put the service_role key or any Paystack/SMS secret here:
# anything starting with VITE_ is bundled into the website and visible to everyone.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: church name shown on the login screen
VITE_CHURCH_NAME=Church Management

# Optional: letters at the start of member IDs (adults <P>A1, Omega <P>O1, children <P>C1).
# Leave out for Testimony Temple (TT). Use DT for Dominion Temple. Must match the letters in the database setup.
VITE_MEMBER_CODE_PREFIX=TT
